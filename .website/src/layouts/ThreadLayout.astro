---
import BoardLayout from './BoardLayout.astro';
import GroupMap from '../components/group-map/group-map.svelte';
import type { GroupMapData } from '../components/group-map/types';
import Breadcrumb from '../components/breadcrumb/breadcrumb.svelte';
import ThreadTitleBand from '../components/thread-title-band/thread-title-band.svelte';
import ThreadPost from '../components/thread-post/thread-post.svelte';
import CopyButton from '../components/copy-button/copy-button.svelte';
import PrevNext from '../components/prev-next/prev-next.svelte';
import JumpTo from '../components/jump-to/jump-to.svelte';
import SlopNotice from '../components/slop-notice/slop-notice.svelte';
import { jumpTargets } from '../pages/_board/navigation';
import type { ThreadLink } from '../components/prev-next/types';
import type { SlopLevel } from '../components/slop-notice/types';

type Props = {
	title: string;
	description: string;
	board: ThreadLink | null;
	group: ThreadLink | null;
	groupMap: GroupMapData | null;
	editHref: string;
	postedDate: string;
	reportHref: string;
	postCount: number;
	previous: ThreadLink | null;
	next: ThreadLink | null;
	slop: SlopLevel | null;
};

const {
	title,
	description,
	board,
	group,
	groupMap,
	editHref,
	postedDate,
	reportHref,
	postCount,
	previous,
	next,
	slop,
} = Astro.props;

const returnTrail = [
	{ label: 'Board Index', href: '/' },
	...(board === null ? [] : [{ label: board.title, href: board.href }]),
	...(group === null ? [] : [{ label: group.title, href: group.href }]),
];
const trail = [...returnTrail, { label: title, href: null }];
const threadUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<BoardLayout title={title} description={description} navCurrent={null}>
	<div class="thread-top">
		<Breadcrumb trail={trail} />
		<div class="adjacent-links">
			{previous !== null && <a href={previous.href}>View previous thread</a>}
			{previous !== null && next !== null && <span>::</span>}
			{next !== null && <a href={next.href}>View next thread</a>}
		</div>
	</div>
	<!-- Pagefind indexes the article and excludes the expandable navigation. -->
	<div class="search-region" data-pagefind-body>
		<div>
			<ThreadTitleBand title={title} code={null} solved={false} editHref={editHref} />
			{groupMap !== null && <GroupMap map={groupMap} currentHref={Astro.url.pathname} />}
		</div>
		<ThreadPost
			author="brandon"
			role="Site Admin"
			header={{ kind: 'posted', postedDate, reportHref }}
			postCount={postCount}
			actions={null}
		>
			<CopyButton client:idle slot="actions" label="Copy link" text={threadUrl} />
			<div class="thread-body">
				{slop !== null && slop !== 'none' && <SlopNotice level={slop} />}
				<slot />
			</div>
		</ThreadPost>
	</div>
	<PrevNext previous={previous} next={next} />
	<div class="thread-return">
		<Breadcrumb trail={returnTrail} />
		<JumpTo client:idle targets={jumpTargets} />
	</div>
</BoardLayout>

<style>
	.thread-top {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-4) var(--space-12);
	}

	.adjacent-links {
		font-size: 10px;
		color: var(--color-text-faint);
		display: flex;
		gap: var(--space-6);
	}

	.adjacent-links a {
		font-size: 10px;
	}

	.thread-return {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-6) var(--space-12);
	}

	/* mirrors the page-content gap so the wrapper is invisible in the flow */
	.search-region {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-20);
	}
</style>
