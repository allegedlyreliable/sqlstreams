---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import ThreadLayout from '../layouts/ThreadLayout.astro';
import { siteThreads } from './_board/threads';
import { threadData } from './_thread/thread';

export const getStaticPaths = (async () => {
	const docs = await getCollection('docs');
	const threads = siteThreads(docs);

	return threads.map((thread) => ({ params: { id: thread.id }, props: { thread } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { thread } = Astro.props;
const docs = await getCollection('docs');
const threads = siteThreads(docs);
const { Content } = await render(thread.entry);
const data = threadData(thread, threads);
---

<ThreadLayout
	title={thread.title}
	description={thread.description}
	board={data.board}
	group={data.group}
	groupMap={data.groupMap}
	editHref={data.editHref}
	postedDate={data.postedDate}
	reportHref={data.reportHref}
	postCount={data.postCount}
	previous={data.previous}
	next={data.next}
	slop={data.slop}
>
	<Content />
</ThreadLayout>
