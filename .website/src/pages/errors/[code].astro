---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import ErrorThreadLayout from '../../layouts/ErrorThreadLayout.astro';
import { isErrorThread, threadCode } from '../_board/identifiers';
import { siteThreads } from '../_board/threads';
import { threadData } from '../_thread/thread';
import { codeMetaDescription, codeThreadData } from '../_thread/code';
import { diagnoseQueries, fixPlaceholders, pastePlaceholders } from '../_thread/diagnose';

export const getStaticPaths = (async () => {
	const docs = await getCollection('docs');
	const threads = siteThreads(docs);

	return docs
		.filter((entry) => isErrorThread(entry.id) && threads.some((thread) => thread.id === entry.id))
		.map((entry) => {
			const thread = threads.find((candidate) => candidate.id === entry.id);
			if (thread === undefined) {
				throw new Error(`error thread "${entry.id}" matches no site thread`);
			}
			return { params: { code: threadCode(entry.id) }, props: { entry, thread } };
		});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, thread } = Astro.props;
const docs = await getCollection('docs');
const threads = siteThreads(docs);
const { Content } = await render(entry);
const data = threadData(thread, threads);
const codeThread = codeThreadData(entry);
const description = codeMetaDescription(codeThread);
---

<ErrorThreadLayout
	title={entry.data.title}
	description={description}
	board={data.board}
	editHref={data.editHref}
	postedDate={data.postedDate}
	reportHref={data.reportHref}
	postCount={data.postCount}
	previous={data.previous}
	next={data.next}
	codeThread={codeThread}
	diagnose={diagnoseQueries(codeThread.code)}
	fixPlaceholders={fixPlaceholders(codeThread.code)}
	pastePlaceholders={pastePlaceholders(codeThread.code)}
>
	<Content />
</ErrorThreadLayout>
