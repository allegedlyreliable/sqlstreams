---
import SandboxPost from './_components/sandbox-post/sandbox-post.svelte';
import { sandboxShell, sandboxStream } from './_board/sandbox';
import { getCollection } from 'astro:content';
import BoardLayout from '../layouts/BoardLayout.astro';
import Breadcrumb from '../components/breadcrumb/breadcrumb.svelte';
import BoardSection from '../components/board-section/board-section.svelte';
import BoardRows from '../components/board-rows/board-rows.svelte';
import StickyRows from '../components/sticky-rows/sticky-rows.svelte';
import BoardStats from '../components/board-stats/board-stats.svelte';
import JumpTo from '../components/jump-to/jump-to.svelte';
import { jumpTargets } from './_board/navigation';
import { boardRows, stickyRows } from './_board/rows';
import { siteThreads } from './_board/threads';

const docs = await getCollection('docs');
const threads = siteThreads(docs);
const rows = boardRows(threads);
const stickies = stickyRows(threads);
const shell = await sandboxShell();
---

<BoardLayout
	title="SQLStreams Board Index"
	description="The message platform forged in Postgres. Queue, event log, and router in one system."
	navCurrent="Board Index"
>
	<Breadcrumb trail={[{ label: 'Board Index', href: '/' }]} />
	<BoardSection title="Start Here" columnLabels={{ threadCount: null, lastPost: 'Updated' }}>
		<StickyRows client:idle stickies={stickies} />
		<SandboxPost
			client:media="(min-width: 761px)"
			stream={sandboxStream}
			messages={shell.messages}
			cursors={shell.cursors}
		/>
	</BoardSection>
	<BoardSection title="Board" columnLabels={{ threadCount: 'Threads', lastPost: 'Last post' }}>
		<BoardRows client:idle rows={rows} />
	</BoardSection>

	<BoardStats docCount={threads.length} />
	<JumpTo client:idle targets={jumpTargets} />
</BoardLayout>
